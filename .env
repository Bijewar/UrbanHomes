DATABASE_URL=file:/home/z/my-project/db/custom.db

# Urban Homes — public env vars (exposed to the client by design)
# Business WhatsApp number in international format, no +, no spaces, no dashes.
# 9343815319 → 91 (India country code) → 919343815319
NEXT_PUBLIC_WHATSAPP_NUMBER=919343815319

# Backup WhatsApp number — also surfaced in the contact section.
NEXT_PUBLIC_WHATSAPP_NUMBER_ALT=919303199175

# Cloudinary free-tier unsigned upload (frontend-only, no backend needed).
# Create a free account at https://cloudinary.com, then:
#   Settings → Upload → Unsigned upload presets → Add one (e.g. "urban-homes-quotes")
#   Enable transformations to auto-optimize + resize on upload (faster + cheaper).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=urban-homes
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=urban-homes-quotes
